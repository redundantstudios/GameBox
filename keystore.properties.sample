# Sample release-signing config. COPY this file to `keystore.properties` in the
# repo root and fill in the real values. `keystore.properties` is gitignored -
# never commit it.
#
# The values below are placeholders. Without a filled-in keystore.properties the
# DEBUG build still works normally (`gradle assembleDebug`); only the signed
# release bundle needs these.
#
# The keystore itself (release-key.jks) must be copied to the repo root as well,
# and is likewise gitignored.
#
# If you would rather not create the file, the two KEYSTORE_* environment
# variables below are used instead.

storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
