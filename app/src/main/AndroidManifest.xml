<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- REQUIRED for AdMob. Every ad request is an HTTPS call; without this
         permission the SDK cannot fetch a single ad and every interstitial and
         rewarded request fails silently. It was missing entirely, which is why
         no ad ever appeared anywhere in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets AdMob report ad revenue accurately. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting">

        <!-- AdMob APPLICATION_ID (app part only, with the ~ separator).
             The app part MUST match the unit ids in AdMobManager.kt:
                ca-app-pub-9565881819222312
             It was Google's public TEST app id before, so the SDK refused our
             live units and no ad ever loaded.

             !! VERIFY THE NUMBER AFTER THE ~ !!
             The app id is published by the AdMob console (AdMob -> App settings
             -> App ID) and also appears in the AdMob SDK log line at startup.
             It is held in ADMOB_APP_ID below and injected here so there is only
             ONE place to change it. If ads still do not load, this suffix is
             the first thing to check. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.ModeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Shell" />
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Shell" />
        <!-- screenOrientation is pinned to PORTRAIT on purpose. The activity is then
             always CREATED portrait, whatever the caller, the sensor or a previous
             landscape game left behind, so a portrait game can never show a sideways
             first frame and then turn. A landscape game is still created portrait and
             only then asks the display to turn (GameActivity.setupOrientation, which
             reads the game's manifest), so the platform animates a real rotation
             instead of the activity starting up already sideways. -->
        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:theme="@style/Theme.Shell.Game" />
    </application>

</manifest>
