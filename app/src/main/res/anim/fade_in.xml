<?xml version="1.0" encoding="utf-8"?>
<!-- Screen-change fades: every activity open/close cross-dissolves instead
     of the platform's hard slide. One easing everywhere (STYLE.md motion rule). -->
<resources>
    <anim name="fade_in" xmlns:android="http://schemas.android.com/apk/res/android"
        android:fromAlpha="0.0" android:toAlpha="1.0"
        android:duration="450" android:interpolator="@android:anim/decelerate_interpolator" />
</resources>
