<?xml version="1.0" encoding="utf-8"?>
<!-- Screen-change transition: cross-dissolve with a gentle rise + settle, so
     motion is visible even between screens that share the same background. -->
<set name="fade_in" xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="420" />
    <translate android:fromYDelta="5%" android:toYDelta="0" android:duration="420" />
    <scale android:fromXScale="0.985" android:toXScale="1.0"
        android:fromYScale="0.985" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="420" />
</set>

