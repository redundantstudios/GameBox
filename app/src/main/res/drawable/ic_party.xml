<?xml version="1.0" encoding="utf-8"?>
<!--
  Party Games tile icon: a party popper - cone, burst rays and confetti.
  Drawn as a white/gold vector so it reads on the tile's pink card colour in
  both light and dark themes. All arcs use the standard two-arc circle idiom
  (rx == ry == r, mid-point translated by 2r) so PathParser accepts it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="76dp"
    android:height="76dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- cone -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.2,20.8 L12,16.8 L7.2,12 Z" />

    <!-- burst rays out of the cone mouth -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M13.4,10.6 L16.4,7.6 M15.8,13.8 L20.6,12.8 M10.2,8.4 L11.2,3.6" />

    <!-- confetti -->
    <path
        android:fillColor="#FFFFD54F"
        android:pathData="M19.6,6.4 m-1.5,0 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0" />
    <path
        android:fillColor="#FFFFD54F"
        android:pathData="M21.4,2.8 m-1,0 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.4,2.4 m-0.9,0 a0.9,0.9 0 1,1 1.8,0 a0.9,0.9 0 1,1 -1.8,0" />
    <path
        android:fillColor="#FFFFD54F"
        android:pathData="M8.4,6.2 m-0.8,0 a0.8,0.8 0 1,1 1.6,0 a0.8,0.8 0 1,1 -1.6,0" />
</vector>

