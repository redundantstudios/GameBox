<?xml version="1.0" encoding="utf-8"?>
<!-- Design-ref chunky slider: beige track, orange fill, bordered thumb -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#D9C7A6" />
            <stroke android:width="2dp" android:color="@color/studio_border_dark" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/studio_accent" />
                <stroke android:width="2dp" android:color="@color/studio_border_dark" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>