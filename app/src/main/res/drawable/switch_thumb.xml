<?xml version="1.0" encoding="utf-8"?>
<!-- Shell-styled switch thumb: cream disc, green ring while on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="26dp"
                android:height="26dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                    <stroke android:width="2dp" android:color="@color/studio_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="26dp"
                android:height="26dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                    <stroke android:width="1dp" android:color="@color/studio_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
