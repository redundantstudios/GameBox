<?xml version="1.0" encoding="utf-8"?>
<!-- Shell-styled switch track: green when on, muted beige when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="42dp"
                android:height="24dp"
                android:gravity="center">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/studio_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="42dp"
                android:height="24dp"
                android:gravity="center">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/studio_muted" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
