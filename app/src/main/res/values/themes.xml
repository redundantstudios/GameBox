<resources>
    <!-- Shell navigation motion: slide push/pop for activity changes. The task
         open/close (the app appearing from the launcher) stays a dissolve —
         that is not a navigation event. -->
    <style name="NavWindowAnim">
        <item name="android:activityOpenEnterAnimation">@anim/nav_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/nav_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/nav_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/nav_out_right</item>
        <item name="android:taskOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/fade_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:taskCloseExitAnimation">@anim/fade_out</item>
        <item name="android:launchTaskBehindTargetAnimation">@anim/fade_in</item>
        <item name="android:launchTaskBehindSourceAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.Shell" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/studio_ink</item>
        <item name="colorPrimaryVariant">@color/studio_ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/studio_accent</item>
        <item name="colorSecondaryVariant">@color/studio_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorAccent">@color/studio_primary</item>
        <item name="colorControlActivated">@color/studio_primary</item>
        <item name="android:statusBarColor">@color/studio_background</item>
        <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowBackground">@color/studio_background</item>
    <item name="android:windowAnimationStyle">@style/NavWindowAnim</item>
    <!-- THE DISPLAY CUTOUT, ON THE SHELL'S OWN SCREENS TOO.
         The launcher's theme carried no cutout declaration, so the platform
         kept its default: in PORTRAIT it LETTERBOXES the content in the camera
         hole, and the hole is painted by the system - a black strip across the
         top of the arcade grid on a punch-hole phone. The game screens have
         declared `always` since the cutout work; the launcher needs it as well,
         so the shell is full screen on every phone, all the time. -->
    <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    <!-- And the same edge-to-edge promise the game screens make: the content
         spans the whole display instead of being shrunk to fit inside it. -->
    <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
    </style>

    <!-- Game windows are OPAQUE, and their background is the SHELL'S own colour.
         Two reasons:
           1. An opaque window is what lets the platform run its real rotation
              animation. A translucent one is composited instead of snapshotted,
              so a portrait -> landscape turn degrades into a crossfade - which
              reads as "the landscape screen appeared, and then something
              animated". Opaque = the content itself turns.
           2. The instant between "the window exists" and "the game has painted"
              shows this colour, so it has to be a colour the shell already is.
              It used to be the game's tile colour, which meant a wall of that
              game's colour (Chicken Chaos's grass green) flashed on open. -->
    <style name="Theme.Shell.Game" parent="Theme.Shell">
        <item name="android:windowBackground">@color/studio_background</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- The window must draw its content across the whole display so the game
             covers the status/navigation bar area. optOut=false keeps Android 15+
             enforcing it rather than shrinking the content to fit. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- THE DISPLAY CUTOUT. The camera hole of the phone is a CORNER cutout,
             so in landscape it lands on a LONG edge and the platform then
             letterboxes the game away from it - a dead band with the camera in
             it, which the player reported as "the game is not full screen".
             Measured on the OPPO A55 (CPH2219, ColorOS): the window frame sat
             at [115,0][2400,1080] - exactly the cutout width - with an
             "EffectLayer (Letterbox - left)" beside it. "always" lets the game
             run under the hole; the system still draws the hole itself.
             This has to live in the THEME: the window attributes are re-applied
             from the theme when the decor is created (setContentView), which
             silently discarded the value set programmatically before that. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Shell</item>
    </style>
</resources>
