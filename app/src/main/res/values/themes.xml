<resources>
    <style name="Theme.Shell" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/studio_ink</item>
        <item name="colorPrimaryVariant">@color/studio_ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">#FAFAFA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/brand_black</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Shell</item>
    </style>
</resources>
