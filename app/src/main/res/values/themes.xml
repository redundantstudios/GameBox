<resources>
    <!-- Fade window animations shared by every screen change. -->
    <style name="FadeWindowAnim">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/fade_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:taskCloseExitAnimation">@anim/fade_out</item>
        <item name="android:launchTaskBehindTargetAnimation">@anim/fade_in</item>
        <item name="android:launchTaskBehindSourceAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.Shell" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/studio_ink</item>
        <item name="colorPrimaryVariant">@color/studio_ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/studio_accent</item>
        <item name="colorSecondaryVariant">@color/studio_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorAccent">@color/studio_primary</item>
        <item name="colorControlActivated">@color/studio_primary</item>
        <item name="android:statusBarColor">@color/studio_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/studio_background</item>
        <item name="android:windowAnimationStyle">@style/FadeWindowAnim</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Shell</item>
    </style>
</resources>
