<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/standard_spacing"
    android:paddingBottom="@dimen/screen_margin">

    <!-- The header lives directly in the screen (no Toolbar) so the 64dp back
         button can never be clipped by an action-bar height limit. -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" 
            android:soundEffectsEnabled="false"/>

    <TextView
        android:id="@+id/modeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="6dp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:shadowColor="#33FFFFFF"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:text="@string/tagline_mode"
        android:textAllCaps="true"
        android:textColor="@color/studio_on_background"
        android:textSize="21sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="21sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Search. Only the All Games page shows it, and the wrapper is GONE
         everywhere else. The top gap lives in the wrapper's padding rather
         than a margin so that a GONE wrapper adds nothing at all and the grid
         keeps the exact spacing it had before. focusableInTouchMode stops the
         field grabbing focus (and the keyboard) as the page opens. -->
    <LinearLayout
        android:id="@+id/searchHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <com.redundantstudios.arcade.ui.ChunkyCardView
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            app:ccBorderColor="@color/studio_border_dark"
            app:ccBorderWidth="3dp"
            app:ccColor="@color/studio_surface"
            app:ccCornerRadius="18dp"
            app:ccShadowColor="@color/studio_border_dark"
            app:ccShadowOffset="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="@color/studio_border_dark" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/search_games_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/studio_on_surface"
                    android:textColorHint="@color/studio_border"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.redundantstudios.arcade.ui.ChunkyCardView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gamesRecyclerView"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_width="0dp"
        android:maxWidth="@dimen/content_max_width"
        android:layout_gravity="center_horizontal"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_section_gap"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchHost"
        app:spanCount="2" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/no_games_here"
            android:textColor="@color/studio_on_background"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_games_here_hint"
            android:textColor="@color/studio_border"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
