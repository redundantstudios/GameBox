<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Game Title"
        android:textAlignment="center"
        android:textColor="#1C1E24"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- SOLO Section -->
    <LinearLayout
        android:id="@+id/soloContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOLO VS AI"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="#7A7F88"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnAiMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-"
                android:backgroundTint="#F5F5F7"
                android:textColor="#1C1E24"
                app:cornerRadius="24dp" />

            <TextView
                android:id="@+id/tvAiCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1C1E24"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnAiPlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:backgroundTint="#F5F5F7"
                android:textColor="#1C1E24"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIFFICULTY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="#7A7F88"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/difficultyPills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnDiffEasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EASY"
                android:textSize="12sp"
                android:backgroundTint="#F5F5F7"
                android:textColor="#1C1E24"
                android:layout_marginEnd="8dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnDiffMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDIUM"
                android:textSize="12sp"
                android:backgroundTint="#1C1E24"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnDiffHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HARD"
                android:textSize="12sp"
                android:backgroundTint="#F5F5F7"
                android:textColor="#1C1E24"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSoloStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START"
            android:backgroundTint="#1C1E24"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- PASS Section -->
    <LinearLayout
        android:id="@+id/passContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASS &amp; PLAY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="#7A7F88"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnHumanMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-"
                android:backgroundTint="#F5F5F7"
                android:textColor="#1C1E24"
                app:cornerRadius="24dp" />

            <TextView
                android:id="@+id/tvHumanCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1C1E24"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnHumanPlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:backgroundTint="#F5F5F7"
                android:textColor="#1C1E24"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPassStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START PASS &amp; PLAY"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1C1E24"
            app:strokeColor="#1C1E24"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/noSoloNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solo mode not supported"
        android:textAlignment="center"
        android:textColor="#7A7F88"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
