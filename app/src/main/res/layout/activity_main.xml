<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/standard_spacing"
    android:paddingBottom="@dimen/standard_spacing">

    <!-- Brand owns the whole first line (auto-sized so it can never wrap or clip);
         the settings gear is tucked into the corner. -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/brandTitle"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="0.03"
        android:maxLines="1"
        android:shadowColor="#33FFFFFF"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:text="@string/app_title"
        android:textAllCaps="true"
        android:textColor="@color/studio_on_background"
        android:textSize="17sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="17sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="3dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings_gear"
        app:layout_constraintBottom_toBottomOf="@id/brandTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/brandTitle" />

    <!-- Single primary action: browse the whole catalogue -->
    <com.redundantstudios.arcade.ui.ChunkyCardView
        android:id="@+id/allGamesCard"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        app:ccBorderColor="@color/brand_cta_border"
        app:ccBorderWidth="3.5dp"
        app:ccColor="@color/brand_cta_fill"
        app:ccCornerRadius="20dp"
        app:ccShadowColor="@color/brand_cta_shadow"
        app:ccShadowOffset="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/allGamesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:shadowColor="#401B5E20"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:text="@string/all_games"
                android:textAllCaps="true"
                android:textColor="@color/brand_cta_text"
                android:textSize="19sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/allGamesSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="10dp"
                android:alpha="0.85"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/all_games_hint"
                android:textAllCaps="true"
                android:textColor="@color/brand_cta_text"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/allGamesChevron"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/allGamesTitle" />

            <ImageView
                android:id="@+id/allGamesChevron"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.redundantstudios.arcade.ui.ChunkyCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/allGamesCard">

        <!-- fillViewport keeps the whole list scrollable; content hangs from the
             top so the grid sits right under the All Games band. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="16dp"
                android:text="@string/section_choose_players" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/modeRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/no_games_installed"
                    android:textColor="@color/studio_on_background"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_games_hint"
                    android:textColor="@color/studio_border"
                    android:textSize="13sp" />


            </LinearLayout>

            <!-- Idea mailbox: players mail us feature/game ideas straight from Home -->
            <com.redundantstudios.arcade.ui.ChunkyCardView
                android:id="@+id/ideaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                app:ccBorderColor="@color/studio_border"
                app:ccBorderWidth="2.5dp"
                app:ccColor="@color/studio_surface"
                app:ccCornerRadius="18dp"
                app:ccShadowColor="#22000000"
                app:ccShadowOffset="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/idea_card_title"
                        android:text="&#9993;"
                        android:textColor="@color/studio_on_background"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:text="@string/idea_card_title"
                            android:textColor="@color/studio_on_background"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/idea_card_hint"
                            android:textColor="@color/studio_border"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.redundantstudios.arcade.ui.ChunkyCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/footer_brand"
        android:textColor="@color/studio_border"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
