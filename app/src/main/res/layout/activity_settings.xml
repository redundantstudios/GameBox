<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_shell"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingTop="@dimen/screen_margin"
    android:paddingBottom="@dimen/screen_margin">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textColor="@color/studio_on_background"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:shadowColor="#33FFFFFF"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ================= AUDIO ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="Audio" />

            <com.redundantstudios.arcade.ui.ChunkyCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:ccColor="@color/studio_surface"
                app:ccBorderColor="@color/studio_border_dark"
                app:ccShadowColor="@color/studio_border_dark"
                app:ccCornerRadius="@dimen/radius_card"
                app:ccBorderWidth="@dimen/border_thickness"
                app:ccShadowOffset="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MASTER SOUND"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selSoundOn"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            app:scText="ON" />

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selSoundOff"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            app:scText="OFF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOLUME"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="20dp" />

                    <SeekBar
                        android:id="@+id/seekVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="80"
                        android:maxHeight="14dp"
                        android:minHeight="14dp"
                        android:splitTrack="false"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb" />
                </LinearLayout>
            </com.redundantstudios.arcade.ui.ChunkyCardView>

            <!-- ================= FEEDBACK ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="Feedback" />

            <com.redundantstudios.arcade.ui.ChunkyCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:ccColor="@color/studio_surface"
                app:ccBorderColor="@color/studio_border_dark"
                app:ccShadowColor="@color/studio_border_dark"
                app:ccCornerRadius="@dimen/radius_card"
                app:ccBorderWidth="@dimen/border_thickness"
                app:ccShadowOffset="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="Vibration" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selVibeOn"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            app:scText="On" />

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selVibeOff"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            app:scText="Off" />
                    </LinearLayout>

                    <TextView
                        style="@style/RowLabel"
                        android:text="Haptic feel"
                        android:layout_marginTop="20dp" />

                    <TextView
                        style="@style/RowHint"
                        android:text="How strong the buzz feels in games"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selHapticSoft"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            app:scText="Soft"
                            app:scSubText="Gentle" />

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selHapticCrisp"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            app:scText="Crisp"
                            app:scSubText="Balanced" />

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selHapticHeavy"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            app:scText="Heavy"
                            app:scSubText="Strong" />
                    </LinearLayout>
                </LinearLayout>
            </com.redundantstudios.arcade.ui.ChunkyCardView>

            <!-- ================= INTERFACE ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="Interface" />

            <com.redundantstudios.arcade.ui.ChunkyCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:ccColor="@color/studio_surface"
                app:ccBorderColor="@color/studio_border_dark"
                app:ccShadowColor="@color/studio_border_dark"
                app:ccCornerRadius="@dimen/radius_card"
                app:ccBorderWidth="@dimen/border_thickness"
                app:ccShadowOffset="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/RowLabel"
                        android:text="Theme" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selThemeLight"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            app:scText="Light" />

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selThemeDark"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            app:scText="Dark" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/studio_muted"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp" />

                    <TextView
                        style="@style/RowLabel"
                        android:text="Developer mode" />

                    <TextView
                        style="@style/RowHint"
                        android:text="Adds in-game test tools (bot speed test)"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selDevOn"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            app:scText="On" />

                        <com.redundantstudios.arcade.ui.SelectCard
                            android:id="@+id/selDevOff"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            app:scText="Off" />
                    </LinearLayout>
                </LinearLayout>
            </com.redundantstudios.arcade.ui.ChunkyCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:text="Redundant Studios · v1.0"
                android:textColor="@color/studio_border"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

