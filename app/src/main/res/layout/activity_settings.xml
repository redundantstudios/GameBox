<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/standard_spacing"
    android:paddingBottom="@dimen/screen_margin">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:shadowColor="#33FFFFFF"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:text="@string/settings"
        android:textAllCaps="true"
        android:textColor="@color/studio_on_background"
        android:textSize="21sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="21sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ================= AUDIO ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_audio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/row_music" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swMusic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        app:track="@drawable/switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/studio_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/row_sfx" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        app:track="@drawable/switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/studio_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/row_volume" />

                    <TextView
                        android:id="@+id/volValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="80%"
                        android:textColor="@color/studio_border"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:maxHeight="14dp"
                    android:minHeight="14dp"
                    android:progress="80"
                    android:progressDrawable="@drawable/seek_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />
            </LinearLayout>

            <!-- ================= FEEDBACK ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_feedback" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/row_vibration" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swVibe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        app:track="@drawable/switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/studio_muted" />

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_haptic_feel" />

                <TextView
                    style="@style/RowHint"
                    android:layout_marginTop="2dp"
                    android:text="@string/row_haptic_feel_hint" />

                <RadioGroup
                    android:id="@+id/hapticGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbHapticSoft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/haptic_soft"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbHapticCrisp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/haptic_crisp"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbHapticHeavy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/haptic_heavy"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>
            </LinearLayout>

            <!-- ================= NOTIFICATIONS ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_notifications" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/row_reminders" />

                        <TextView
                            style="@style/RowHint"
                            android:layout_marginTop="2dp"
                            android:text="@string/row_reminders_hint" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swReminders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        app:track="@drawable/switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/studio_muted" />

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_reminder_time" />

                <RadioGroup
                    android:id="@+id/slotGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbSlotMorning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/slot_morning"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbSlotAfternoon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/slot_afternoon"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbSlotEvening"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/slot_evening"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/studio_muted" />

                <TextView
                    android:id="@+id/btnTestNotif"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_small_button"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/btn_send_test"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ================= INTERFACE ================= -->
            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_interface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/row_theme" />

                <TextView
                    style="@style/RowHint"
                    android:layout_marginTop="2dp"
                    android:text="@string/row_theme_hint" />

                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbThemeLight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/theme_light"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbThemeDark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_shell"
                        android:buttonTint="@color/radio_tint"
                        android:letterSpacing="0.04"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/theme_dark"
                        android:textAllCaps="true"
                        android:textColor="@color/studio_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/studio_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowLabel"
                            android:text="@string/row_developer_mode" />

                        <TextView
                            style="@style/RowHint"
                            android:layout_marginTop="2dp"
                            android:text="@string/row_developer_mode_hint" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swDev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        app:track="@drawable/switch_track" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/footer_brand"
                android:textColor="@color/studio_border"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>


