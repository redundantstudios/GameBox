# Local artifacts
shell-debug.apk
# Release signing secrets - NEVER commit. See PLAY_RELEASE_KEY.txt (local only).
PLAY_RELEASE_KEY.txt
# Real signing passwords. Copy from keystore.properties.sample, fill it in, keep
# it local. A contributor can clone and build the DEBUG apk without it.
keystore.properties
# JVM crash heap dump (794 MB) from a killed Gradle daemon - build junk.
*.hprof
# Root-level BGM scratch copies. The audio the app ships lives in
# app/src/main/res/raw/ and is generated by Tools/_gen_bgm.py (see BUILD.md).
/shellbgm.mp3
/shellbgm_loop.mp3
# Generated-audio backup scratch. The app's audio is produced by
# Tools/_gen_audio.py + Tools/_gen_bgm.py into app/src/main/res/raw/.
Tools/_audio_backup/
*.log
build_log.txt
uiautomator_dump.xml
tmp_*
pm_diff.txt

# Local debugging scratch (screenshots / logs pulled from the device)
_*.png
_*.txt

# Python bytecode
__pycache__/
*.pyc

# Generated audio assets - NOT in git on purpose (keeps the repo text-only).
# They are produced from the committed generator scripts; run both before building:
#     python Tools/_gen_audio.py   (sfx_tap / sfx_select / sfx_back / sfx_tick + bgm take 1)
#     python Tools/_gen_bgm.py     (bgm_shell, seamless loop - overwrites the take-1 bgm)
# Requires ffmpeg with libvorbis on PATH. See BUILD.md, Audio Assets section.
# notif_chime.ogg has NO committed generator yet - see the note in BUILD.md.
app/src/main/res/raw/*.ogg
app/src/main/res/raw/*.wav

# Raw puzzle source dump (2.7 MB Lichess export). The runtime asset
# games/chess/puzzles.js IS committed; regenerate it with:
#     python Tools/_gen_puzzles.py
sources/LockedGames/chess_puzzles.txt
